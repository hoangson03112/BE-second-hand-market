# =============================================================================
# BẮT BUỘC — thiếu bất kỳ dòng nào ở khối này thì server sẽ KHÔNG khởi động.
# Sinh secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# =============================================================================

NODE_ENV=development
PORT=5000

# Chuỗi kết nối MongoDB
MONGODB_URI=mongodb://localhost:27017/eco-market

# Hai secret PHẢI khác nhau và >= 32 ký tự (bắt buộc kiểm ở production)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Danh sách origin được phép, phân tách bằng dấu phẩy. KHÔNG dùng "*" — API gửi cookie.
# Nếu bỏ trống, hệ thống sẽ dùng CLIENT_URL.
CORS_ORIGIN=http://localhost:3000

# URL gốc của frontend (link xác thực email, redirect OAuth).
# Nếu bỏ trống, hệ thống sẽ dùng CLIENT_URL.
FRONTEND_URL=http://localhost:3000

# Dùng làm giá trị thay thế cho CORS_ORIGIN và FRONTEND_URL khi hai biến trên trống
CLIENT_URL=http://localhost:3000

# =============================================================================
# TÙY CHỌN — thiếu thì chỉ tính năng tương ứng ngừng hoạt động, server vẫn chạy.
# Server sẽ in cảnh báo lúc khởi động cho từng nhóm bị thiếu.
# =============================================================================

# --- Thời hạn token -----------------------------------------------------------
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_DOMAIN=

# --- Upload ảnh (Cloudinary) --------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Gửi email (Brevo) --------------------------------------------------------
BREVO_API_KEY=
MAIL_FROM_EMAIL=
SUPPORT_EMAIL=

# --- Đăng nhập Google ---------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Vận chuyển GHN -----------------------------------------------------------
GHN_API_URL=https://dev-online-gateway.ghn.vn/shiip/public-api
GHN_TOKEN=
GHN_API_TOKEN=
GHN_SHOP_ID=
GHN_WEBHOOK_TOKEN=

# --- Redis --------------------------------------------------------------------
# Ưu tiên Upstash (REST). Nếu dùng Redis tự host thì điền nhóm REDIS_* bên dưới.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# --- Tìm kiếm (Meilisearch) ---------------------------------------------------
MEILI_HOST=
MEILI_MASTER_KEY=
MEILI_API_KEY=
MEILI_PRODUCT_INDEX=products

# --- Kiểm duyệt & gợi ý bằng AI ----------------------------------------------
GOOGLE_AI_KEY=
GOOGLE_AI_MODERATION_KEY=
GOOGLE_AI_EMBEDDING_KEY=
GOOGLE_PERSPECTIVE_API_KEY=
HUGGINGFACE_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_USE_FREE=true

GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_MODERATION_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768
PRODUCT_VECTOR_INDEX=product_vector_index

AI_PRIMARY_SERVICE=gemini
AI_CONFIDENCE_THRESHOLD=0.7
AUTO_APPROVE_THRESHOLD=0.9
AUTO_REJECT_THRESHOLD=0.3
MAX_COST_PER_PRODUCT=0.01

# --- Quy trình hoàn tiền (giờ) ------------------------------------------------
REFUND_SELLER_RESPONSE_SLA_HOURS=48
REFUND_PROCESSING_SLA_HOURS=72

# --- Khác ---------------------------------------------------------------------
BASE_URL=http://localhost:5000
LOG_LEVEL=2
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
